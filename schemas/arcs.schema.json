{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/Nekopawa/bsd-explorer/main/schemas/arcs.schema.json",
    "title": "Story arcs",
    "description": "All arcs in the BSD series.",
    "type": "array",
    "items": {
        "type": "object",
        "description": "An arc in the BSD series.",
        "properties": {
            "id": {
                "type": "string",
                "description": "The ID of the story arc.",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                "minLength": 1
            },
            "name": {
                "type": "string",
                "description": "The name of the story arc.",
                "minLength": 1
            },
            "japaneseName": {
                "type": "string",
                "description": "The japanese name of the story arc.",
                "minLength": 1
            },
            "saga": {
                "type": "string",
                "description": "The ID of the saga that contains the story arc.",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                "minLength": 1
            },
            "description": {
                "type": "string",
                "description": "The description of the story arc.",
                "minLength": 1
            },
            "sourceMedia": {
                "type": "array",
                "description": "The different media that feature the story arc.",
                "items": {
                    "type": "object",
                    "description": "The media that feature the story arc.",
                    "properties": {
                        "mediaId": {
                            "type": "string",
                            "description": "The ID that references the media in media.json.",
                            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                            "minLength": 1
                        },
                        "chapters": {
                            "type": "object",
                            "description": "The chapters of the manga that feature the story arc.",
                            "properties": {
                                "start": {
                                    "type": "number",
                                    "description": "The chapter that starts featuring the story arc.",
                                    "minimum": 0
                                },
                                "end": {
                                    "type": ["number", "null"],
                                    "description": "The chapter that ends featuring the story arc.",
                                    "minimum": 0
                                },
                                "note": {
                                    "type": "string",
                                    "description": "A note about the range of chapters."
                                }
                            },
                            "required": ["start", "end"],
                            "additionalProperties": false
                        },
                        "volumes": {
                            "type": "object",
                            "description": "The volumes of the manga that feature the story arc.",
                            "properties": {
                                "start": {
                                    "type": "integer",
                                    "description": "The volume that starts featuring the story arc.",
                                    "minimum": 0
                                },
                                "end": {
                                    "type": ["integer", "null"],
                                    "description": "The volume that ends featuring the story arc.",
                                    "minimum": 0
                                },
                                "note": {
                                    "type": "string",
                                    "description": "A note about the range of volumes."
                                }
                            },
                            "required": ["start", "end"],
                            "additionalProperties": false
                        },
                        "episodes": {
                            "type": "array",
                            "description": "The ranges of episodes of the anime that feature the story arc.",
                            "items": {
                                "type": "object",
                                "description": "One range of episodes of the anime that features the story arc.",
                                "properties": {
                                    "start": {
                                        "type": "integer",
                                        "description": "The episode that starts featuring the story arc.",
                                        "minimum": 1
                                    },
                                    "end": {
                                        "type": ["integer", "null"],
                                        "description": "The episode that ends featuring the story arc.",
                                        "minimum": 1
                                    },
                                    "note": {
                                        "type": "string",
                                        "description": "A note about the range of episodes."
                                    }
                                },
                                "required": ["start", "end"],
                                "additionalProperties": false
                            },
                            "minItems": 1
                        }
                    },
                    "required": ["mediaId"],
                    "additionalProperties": false
                },
                "minItems": 1
            },
            "previousArcId": {
                "type": ["string", "null"],
                "description": "The ID of the story arc that occurs chronologically before the current one.",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                "minLength": 1
            },
            "nextArcId": {
                "type": ["string", "null"],
                "description": "The ID of the story arc that occurs chronologically after the current one.",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                "minLength": 1
            }
        },
        "required": [
            "id",
            "name",
            "japaneseName",
            "saga",
            "description",
            "sourceMedia",
            "previousArcId",
            "nextArcId"
        ],
        "additionalProperties": false
    }
}
