{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/Nekopawa/bsd-explorer/main/schemas/events.schema.json",
    "title": "Events",
    "description": "Main events in the BSD universe.",
    "type": "array",
    "items": {
        "type": "object",
        "description": "An event that happened in the BSD universe.",
        "properties": {
            "id": {
                "type": "string",
                "description": "The unique identifier for the event.",
                "minLength": 1,
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            },
            "name": {
                "type": "string",
                "description": "The name of the event.",
                "minLength": 1
            },
            "japaneseName": {
                "type": "string",
                "description": "The japanese name of the event.",
                "minLength": 1
            },
            "description": {
                "type": "string",
                "description": "The description of the event.",
                "minLength": 1
            },
            "location": {
                "type": ["string", "null"],
                "description": "The location where the event occurred.",
                "minLength": 1,
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            },
            "outcome": {
                "type": "array",
                "description": "The outcomes of the event.",
                "items": {
                    "type": "string",
                    "description": "One outcome of the event.",
                    "minLength": 1
                }
            },
            "casualties": {
                "type": "array",
                "description": "The casualties of the event.",
                "items": {
                    "type": "string",
                    "description": "One of the casualties of the event.",
                    "minLength": 1
                }
            },
            "previousEventId": {
                "type": ["string", "null"],
                "description": "The ID of the event that ocurred before the current one.",
                "minLength": 1,
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            },
            "nextEventId": {
                "type": ["string", "null"],
                "description": "The ID of the event that occurred after the current one.",
                "minLength": 1,
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            }
        },
        "required": [
            "id",
            "name",
            "japaneseName",
            "description",
            "location",
            "outcome",
            "casualties",
            "previousEventId",
            "nextEventId"
        ],
        "additionalProperties": false
    }
}
